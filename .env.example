# =============================================================
# WinterFur Manage - Environment Configuration Example
# =============================================================

# Next.js Port & Host
PORT=3000
HOSTNAME=0.0.0.0

# Public URL of this portal
NEXT_PUBLIC_APP_URL=https://manage.winterfur.org

# Keycloak OIDC Backbone
KEYCLOAK_ISSUER=https://identity.winterfur.org/realms/winterfur
KEYCLOAK_CLIENT_ID=wtf-manage
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# NextAuth / Session Secret (32+ char random string)
AUTH_SECRET=generate-random-secret-key-32-chars

